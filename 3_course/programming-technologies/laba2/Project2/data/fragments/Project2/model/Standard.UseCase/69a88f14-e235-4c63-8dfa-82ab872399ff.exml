          <ID name="" mc="Infrastructure.Note" uid="3200e062-1a47-4b3b-820d-c5ecaf99f64d"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Автор или Оператор запускает обновление данных о цитированиях. Система запрашивает внешние наукометрические базы данных по API, извлекает актуальное количество цитирований для выбранных публикаций и обновляет соответствующие счетчики в локальной базе данных. По окончании вызывается расчет индекса цитирования.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
