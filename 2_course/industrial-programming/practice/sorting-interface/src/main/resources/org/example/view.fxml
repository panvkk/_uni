<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="60"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="60"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Номер:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="searchNumber" promptText="Поиск..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Имя:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="searchName" promptText="Поиск..." GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Группа:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="searchGroup" promptText="Поиск..." GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Балл:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="searchGrade" promptText="Поиск..." GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Загрузить файл" onAction="#onLoad"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Сортировка:"/>
        <ComboBox fx:id="sortBox" prefWidth="150"/>
        <Button text="Применить" onAction="#onApplySort"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNumber" text="Номер зачетки"/>
            <TableColumn fx:id="colName" text="Имя студента"/>
            <TableColumn fx:id="colGroup" text="Группа"/>
            <TableColumn fx:id="colGrade" text="Средний балл"/>
        </columns>
    </TableView>

</VBox>