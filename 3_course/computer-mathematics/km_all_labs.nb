 RowBox[{
  FractionBox["1", "2"], "-", 
  FractionBox["1", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "n", "+", 
      SuperscriptBox["n", "2"]}], ")"}]}]]}]], "Output",
 CellChangeTimes->{3.9988322275066433`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"94687661-7e4f-6548-a534-a36ea53af06f"]
