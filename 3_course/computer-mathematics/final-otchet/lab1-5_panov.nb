Cell[CellGroupData[{

Cell["Solve[a*x^4 + b*x^3 + 1 == 0, x]", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"8c921c90-2b6c-984b-bad7-c0302e84e853"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["b", 
        RowBox[{"4", " ", "a"}]]}], "+", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       SqrtBox[
        RowBox[{
         FractionBox[
          SuperscriptBox["b", "2"], 
          RowBox[{"4", " ", 
           SuperscriptBox["a", "2"]}]], "+", 
         FractionBox[
          RowBox[{"4", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["2", "3"], ")"}], 
            RowBox[{"1", "/", "3"}]]}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"9", " ", 
              SuperscriptBox["b", "2"]}], "+", 
             RowBox[{
              SqrtBox["3"], " ", 
              SqrtBox[
               RowBox[{
                RowBox[{
                 RowBox[{"-", "256"}], " ", 
                 SuperscriptBox["a", "3"]}], "+", 
                RowBox[{"27", " ", 
                 SuperscriptBox["b", "4"]}]}]]}]}], ")"}], 
           RowBox[{"1", "/", "3"}]]], "+", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"9", " ", 
              SuperscriptBox["b", "2"]}], "+", 
             RowBox[{
              SqrtBox["3"], " ", 
              SqrtBox[
               RowBox[{
                RowBox[{
                 RowBox[{"-", "256"}], " ", 
                 SuperscriptBox["a", "3"]}], "+", 
                RowBox[{"27", " ", 
                 SuperscriptBox["b", "4"]}]}]]}]}], ")"}], 
           RowBox[{"1", "/", "3"}]], 
          RowBox[{
           SuperscriptBox["2", 
