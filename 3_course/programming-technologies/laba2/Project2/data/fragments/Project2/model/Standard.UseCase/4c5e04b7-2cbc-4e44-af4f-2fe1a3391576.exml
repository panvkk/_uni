        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="3dc7e9f4-dde5-4102-872d-55846cbe382f"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[При обнаружении публикаций с похожими или совпадающими инициалами авторов система формирует список потенциальных совпадений. Автор просматривает предложенные публикации, подтверждает свое авторство для подлинных работ или отклоняет чужие. Перечень привязанных публикаций корректируется.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
