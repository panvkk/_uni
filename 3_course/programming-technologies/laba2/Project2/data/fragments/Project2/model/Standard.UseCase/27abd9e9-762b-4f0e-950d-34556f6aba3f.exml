        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="f4dad800-de35-4dc8-8d01-4d88e387a8ff"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[В системе имеются нераспределенные публикации с совпадающими ФИО/инициалами.]]></ATT>
