Cell["\:0431) \:0412\:044b\:0447\:0438\:0441\:043b\:0438\:0442\:044c \:0441\
\:0443\:043c\:043c\:0443 Sum[k/(k^4 + k^2 + 1), {k, 1, n}] ", "Text",
 CellChangeTimes->{{3.9988321985193405`*^9, 3.9988322128012466`*^9}, {
  3.9988328702903557`*^9, 
  3.9988328704480953`*^9}},ExpressionUUID->"52c76e9a-da3c-c146-bccf-\
e6a05a9d8eae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"k", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"k", "^", "4"}], "+", 
      RowBox[{"k", "^", "2"}], "+", "1"}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998832225561754*^9, 3.99883222556275*^9}},
