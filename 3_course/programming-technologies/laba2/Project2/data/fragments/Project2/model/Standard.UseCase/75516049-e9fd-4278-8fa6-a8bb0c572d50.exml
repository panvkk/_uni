        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="c411d65f-1da1-4ed0-b6a9-478855eb4247"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Автор переходит в личный кабинет и запрашивает список привязанных к нему публикаций. Система отображает перечень записей. Автор может редактировать метаданные (аннотацию, ключевые слова, ссылки), добавлять новые статьи вручную или скрывать записи из публичного профиля. Сохраненные изменения сразу отражаются в системе.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
