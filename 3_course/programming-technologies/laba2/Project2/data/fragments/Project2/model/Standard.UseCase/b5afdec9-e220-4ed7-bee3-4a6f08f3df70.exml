        </OBJECT>
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="435b2d76-4b1f-4370-b904-b63392e60a35"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Автор вводит поисковый запрос (название статьи, DOI или ключевые слова) для поиска публикаций, отсутствующих в его профиле. Из результатов поиска автор выбирает нужную статью и отправляет заявку на подтверждение авторства. Заявка отправляется на рассмотрение оператору системы.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
