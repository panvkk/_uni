Cell[CellGroupData[{

Cell["\<\
DSolve[y''[x] x^2 + 5 y'[x] x + y[x] == 0, y[x], x] // Simplify\
\>", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"87677b1a-8a82-7a4c-ad10-445744323f42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "2"}], "-", 
       SqrtBox["3"]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"C", "[", "1", "]"}], "+", 
       RowBox[{
        SuperscriptBox["x", 
         RowBox[{"2", " ", 
          SqrtBox["3"]}]], " ", 
        RowBox[{"C", "[", "2", "]"}]}]}], ")"}]}]}], "}"}], "}"}]], "Output",
 FontFamily->"Arial",ExpressionUUID->"78641f31-3fbf-2841-ab57-0c9734c6cf63"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DSolve[y''[x] x^2 + 3 y'[x] x + y[x] == Sin[2 x], y[x], x]", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"b7a3be92-7a0a-464f-b765-2cd0a44829c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{"C", "[", "1", "]"}], "x"], "-", 
     FractionBox[
      RowBox[{"CosIntegral", "[", 
       RowBox[{"2", " ", "x"}], "]"}], 
      RowBox[{"2", " ", "x"}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"C", "[", "2", "]"}], " ", 
       RowBox[{"Log", "[", "x", "]"}]}], "x"]}]}], "}"}], "}"}]], "Output",
 FontFamily->"Arial",ExpressionUUID->"e300274e-f5f2-0745-88cc-5c3137b7cb3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
DSolve[{y''[x] x^2 + 5 y'[x] x + y[x] == Power[x, -2 + Sqrt[3]], y[1] == \
-1/12, y'[1] == 1/12 (2 + Sqrt[3])}, y[x], x]\
\>", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"9c17a82b-bcc9-e244-b8ef-7990f34502b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "12"], " ", 
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "2"}], "+", 
       SqrtBox["3"]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", " ", 
        SqrtBox["3"], " ", 
        RowBox[{"Log", "[", "x", "]"}]}]}], ")"}]}]}], "}"}], "}"}]], "Output",
 FontFamily->"Arial",ExpressionUUID->"b7248fb2-5ef2-0041-8303-cf03400febd6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
TraditionalForm[DSolve[y''[x] + y[x]/Sin[x]^2 == 0, y[x], x]]\
\>", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"4c472916-aec1-c543-bc2b-d091008721f2"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"y", "(", "x", ")"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        TagBox["c",
         C], "1"], " ", 
       RadicalBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["cos", "2"], "(", "x", ")"}], "-", "1"}], "4"], " ", 
       TemplateBox[{
         RowBox[{"-", 
           FractionBox["1", "2"]}], 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", 
            SqrtBox["3"]}], "2"], 
         RowBox[{"cos", "(", "x", ")"}]},
        "LegendreP3"]}], "+", 
      RowBox[{
       SubscriptBox[
        TagBox["c",
         C], "2"], " ", 
       RadicalBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["cos", "2"], "(", "x", ")"}], "-", "1"}], "4"], " ", 
       TemplateBox[{
         RowBox[{"-", 
           FractionBox["1", "2"]}], 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", 
            SqrtBox["3"]}], "2"], 
         RowBox[{"cos", "(", "x", ")"}]},
        "LegendreQ3"]}]}]}], "}"}], "}"}], TraditionalForm]], "Output",
 FontFamily->"Arial",ExpressionUUID->"a39404e5-2c0c-0044-b873-f74e98f56f1f"]
}, Open  ]],

Cell["(*\:0417\:0430\:0434\:0430\:043d\:0438\:0435 8*)", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"1aaa4695-f61e-6b47-8094-1a575e9636c3"],

Cell[CellGroupData[{

Cell["\<\
DSolve[{x'[t] == t^2 + y[t], y'[t] == x[t]}, {x[t], y[t]}, t] // FullSimplify\
\>", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"8c92f027-8317-4c4a-87a5-84b6c7f98ffc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "t"}], "+", 
      RowBox[{
       RowBox[{"C", "[", "1", "]"}], " ", 
       RowBox[{"Cosh", "[", "t", "]"}]}], "+", 
      RowBox[{
       RowBox[{"C", "[", "2", "]"}], " ", 
       RowBox[{"Sinh", "[", "t", "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"-", "2"}], "-", 
      SuperscriptBox["t", "2"], "+", 
      RowBox[{
       RowBox[{"C", "[", "2", "]"}], " ", 
       RowBox[{"Cosh", "[", "t", "]"}]}], "+", 
      RowBox[{
       RowBox[{"C", "[", "1", "]"}], " ", 
       RowBox[{"Sinh", "[", "t", "]"}]}]}]}]}], "}"}], "}"}]], "Output",
 FontFamily->"Arial",ExpressionUUID->"65cbfed4-0039-f34c-b77c-701b2ad57d58"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
DSolve[{y''[t] == 4 x[t] - 5 y[t], x''[t] == 4 y[t] - 5 x[t], y[0] == 1, x[0] \
== 0, y'[0] == 0, x'[0] == 1}, {x[t], y[t]}, t] // FullSimplify\
\>", "Input",
 FontFamily->"Consolas",
 FontSize->12,ExpressionUUID->"ffbfc847-c1b2-9c4b-a2f2-042061654646"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], "-", 
           RowBox[{"Cos", "[", 
            RowBox[{"3", " ", "t"}], "]"}], "+", 
           RowBox[{"Sin", "[", "t", "]"}]}], ")"}]}], "+", 
        RowBox[{"Sin", "[", 
         RowBox[{"3", " ", "t"}], "]"}]}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "+", 
         RowBox[{"Cos", "[", 
          RowBox[{"3", " ", "t"}], "]"}]}], ")"}]}], "+", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "t", "]"}], "3"]}], "3"]}]}]}], "}"}], 
  "}"}]], "Output",
 FontFamily->"Arial",ExpressionUUID->"6d098460-ec44-864d-8c46-7b8bcd9e4a1d"]
}, Open  ]],

