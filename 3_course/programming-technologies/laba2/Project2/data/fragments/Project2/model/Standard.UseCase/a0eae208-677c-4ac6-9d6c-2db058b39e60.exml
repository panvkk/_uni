      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="b618f507-84f4-4d5c-971f-8819517a51b3"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Оператор системы загружает файл формата .bib в интерфейс. Система считывает файл, выполняет синтаксический анализ структуры BibTeX, извлекает метаданные записей (название, авторы, год, журнал/конференция, DOI) и сохраняет их в базу данных. По завершении обработки выводится отчет о количестве успешно импортированных публикаций.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="21f10e30-488f-4650-a4a5-9f7fd1ff637c"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Размер загружаемого файла не должен превышать 50 МБ. Кодировка файла — UTF-8.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
